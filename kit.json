    {"id": "why", "type": "cards", "items": [
      {"title": {"en": "Grounded", "es": "Con fuentes"}, "icon": "link", "kicker": {"en": "Sources", "es": "Fuentes"},
       "href": "docs/architecture/RETRIEVAL.md",
       "text": {"en": "Every note cites the files that prove it. When a cited file changes, Rekora flags the note as possibly stale.",
                "es": "Cada memoria cita los archivos que la prueban. Si un archivo citado cambia, Rekora la marca como posiblemente desactualizada."}},
      {"title": {"en": "Trustworthy", "es": "Confiable"}, "icon": "shield", "kicker": {"en": "Review", "es": "Revisión"},
       "href": "docs/architecture/SECURITY.md",
       "text": {"en": "Agents can only suggest. A person verifies. Stored text is data, never instructions, and secrets are redacted first.",
                "es": "Los agentes solo sugieren y una persona verifica. Lo guardado son datos, nunca instrucciones, y los secretos se ocultan."}},
      {"title": {"en": "Local and tiny", "es": "Local y ligero"}, "icon": "box", "kicker": {"en": "Offline", "es": "Offline"},
       "href": "docs/architecture/OVERVIEW.md", "tags": ["Rust", "SQLite"],
       "text": {"en": "One executable, no model, no daemon, no telemetry. One SQLite file per project in .rekora/, ignored by Git.",
                "es": "Un ejecutable, sin modelo, sin daemon y sin telemetría. Un archivo SQLite por proyecto en .rekora/, ignorado por Git."}},
      {"title": {"en": "Survives a cut-off", "es": "Aguanta un corte"}, "icon": "repeat", "kicker": {"en": "Handoffs", "es": "Handoffs"}, "badge": {"en": "New", "es": "Nuevo"},
       "href": "docs/architecture/ADAPTERS.md#lifecycle-hooks-automatic-handoff",
       "text": {"en": "If an agent runs out of credits mid-task, the next one starts with the open tasks, the last turn and the pending changes.",
                "es": "Si un agente se queda sin créditos a medias, el siguiente arranca con las tareas abiertas, el último turno y los cambios pendientes."}}
    ]},
    {"id": "different", "type": "bento", "columns": 3, "cells": [
      {"icon": "code", "kicker": "Rust", "title": {"en": "One binary", "es": "Un solo binario"}, "text": {"en": "No runtime, no daemon, no server to host.", "es": "Sin runtime, sin daemon, sin servidor que hospedar."}},
      {"icon": "close", "kicker": {"en": "Writes", "es": "Escritura"}, "title": {"en": "No LLM writes", "es": "Ningún LLM escribe"}, "text": {"en": "Nothing is summarized or rewritten by a model before it is stored.", "es": "Ningún modelo resume ni reescribe nada antes de guardarlo."}},
      {"icon": "shield", "kicker": {"en": "Trust", "es": "Confianza"}, "title": {"en": "No self-verify", "es": "Sin autoverificar"}, "text": {"en": "Agent text stays candidate until a human verifies it.", "es": "Lo que escribe un agente queda como candidate hasta que alguien lo verifica."}},
      {"icon": "search", "kicker": {"en": "Search", "es": "Búsqueda"}, "title": {"en": "Strict abstention", "es": "Abstención estricta"}, "text": {"en": "Below the coverage floor the answer is no_evidence, not a guess.", "es": "Bajo el umbral de cobertura responde no_evidence, no una suposición."}},
      {"icon": "repeat", "kicker": {"en": "Tasks", "es": "Tareas"}, "title": {"en": "Versioned handoffs", "es": "Handoffs versionados"}, "text": {"en": "Concurrent edits fail with version_conflict instead of overwriting.", "es": "Las ediciones simultáneas fallan con version_conflict en vez de pisarse."}},
      {"icon": "branch", "kicker": "Git", "title": {"en": "Worktree-aware", "es": "Entiende worktrees"}, "text": {"en": "One store per repository, shared by linked worktrees, ranked by branch.", "es": "Un almacén por repositorio, compartido entre worktrees y ordenado por rama."}}
    ]},
